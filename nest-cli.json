{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "webpackConfigPath": "webpack-hmr.config.js",
    "assets": [
      {
        "include": "shared/modules/app-i18n/translate/**/*",
        "watchAssets": true
      },
      {
        "include": "services/mail/templates/**/*.hbs",
        "watchAssets": true
      }
    ]
  }
}