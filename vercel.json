{
    "version": 2,
    "buildCommand": "npm run build",
    "devCommand": "npm run start:prod",
    "installCommand": "npm install",
    "functions": {
        "dist/main.js": {
            "runtime": "@vercel/node@18"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/dist/main.js"
        }
    ]
}