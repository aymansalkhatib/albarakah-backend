# =========================================
# 🚀 Production Environment Configuration
# =========================================

# 🌐 Application Port
PORT=3000


# ===================================
# 🔑 JWT Access Token Configuration
# ===================================

# Secret key used to sign access tokens (keep it secure!)
JWT_ACCESS_SECRET=DUMMY_JWT_SECRET_KEY_REPLACE_ME

# Access token expiration time in milliseconds
# 15 minutes = 15 * 60 * 1000 = 900000
JWT_ACCESS_EXPIRES_IN_MS=900000


# =====================================
# 🛢️ PostgreSQL Database Configuration
# =====================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DUMMY_PASSWORD_REPLACE_ME
POSTGRES_DATABASE=barakah_charity


# ===================================
# 👤 Super Admin Account Configuration
# ===================================

# Default password for the initial super admin
SUPER_ADMIN_PASSWORD=DUMMY_ADMIN_PASSWORD_REPLACE_ME
