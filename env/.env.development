# Development Environment Configuration

# Port the application will run on
PORT=3000


# Secret key for JWT authentication (ensure this is a secure, private key)
JWT_SECRET=my-super-secret-key

# Firebase Storage bucket for storing files
STORAGE_BUCKET=gs://pro-finder-f7777.appspot.com



# Firebase Service Account credentials file (should be a path to the .json file or a string for service account key)
# Replace with your actual Firebase service account JSON string or file path
FIREBASE_SERVICE_ACCOUNT='(•‿•)' 



# SMTP Configuration for sending emails
# SMTP host for Gmail (used in this case)
SMTP_HOST=smtp.gmail.com

# SMTP port for secure communication (587 is used for TLS)
SMTP_PORT=587

# Whether to use secure (SSL) connection for the SMTP server (false for non-SSL)
# Typically false for Gmail on port 587 (TLS)
SMTP_SECURE=false  

# SMTP user for authentication (Gmail account used to send emails)
SMTP_USER=profinder91@gmail.com

# SMTP password for authentication (replace with a proper password or app-specific password)
SMTP_PASS=jcdo ispq smco nxfd

# Default sender email address for outgoing emails
SMTP_FROM=test@example.com



# Supabase configuration
# The Supabase service role key
SUPABASE_SERVICE_ROLE_KEY='(•‿•)'  
 # The Supabase bucket name
SUPABASE_BUCKET='(•‿•)'           
# The Supabase URL
SUPABASE_URL='(•‿•)'               



# Access Token Settings
# Secret key for signing access tokens
JWT_ACCESS_SECRET=DUMMY_JWT_SECRET_KEY_REPLACE_ME        
# Access token expiration (example: 15m)
JWT_ACCESS_EXPIRES_IN_MS=900000 # 15 minutes = 15 * 60 * 1000 = 900000 ms

# Refresh Token Settings
# Secret key for signing refresh tokens
JWT_REFRESH_SECRET=your-refresh-secret-key       
# Refresh token expiration (example: 7d)
JWT_REFRESH_EXPIRES_IN_MS=604800000  # 7 days = 7 * 24 * 60 * 60 * 1000

# Security Token Settings
# Secret key for security tokens (email verification, password reset, etc.)
JWT_SECURITY_SECRET=your-security-secret-key 
# Security token expiration (example: 5m)
JWT_SECURITY_EXPIRES_IN_MS=300000 # 5 minutes = 5 * 60 * 1000 = 300000 ms

# 📂 SQLite database file path
SQLITE_DATABASE_PATH=./database/sqlite.db


POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database_name

# ======================================
